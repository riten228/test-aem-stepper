<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          jcr:primaryType="nt:unstructured"
          sling:resourceType="cq/gui/components/authoring/dialog">
    <content jcr:primaryType="nt:unstructured">
        <items jcr:primaryType="nt:unstructured">
            <tabs jcr:primaryType="nt:unstructured">
                <items jcr:primaryType="nt:unstructured">
                    <basic jcr:primaryType="nt:unstructured">
                        <items jcr:primaryType="nt:unstructured">
                            <columns jcr:primaryType="nt:unstructured">
                                <items jcr:primaryType="nt:unstructured">
                                    <column jcr:primaryType="nt:unstructured">
                                        <items jcr:primaryType="nt:unstructured">
                                            <displayStyle jcr:primaryType="nt:unstructured"
                                                          sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                          fieldLabel="Display style"
                                                          fieldDescription="Default keeps the core checkbox group UI."
                                                          name="./displayStyle">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <default jcr:primaryType="nt:unstructured" text="Default" value="default" selected="{Boolean}true"/>
                                                    <card jcr:primaryType="nt:unstructured" text="Card" value="card"/>
                                                    <cardtick jcr:primaryType="nt:unstructured" text="Card with tick mark" value="card-tick"/>
                                                </items>
                                            </displayStyle>
                                            <selectionMode jcr:primaryType="nt:unstructured"
                                                           sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                           fieldLabel="Selection mode"
                                                           fieldDescription="Single allows only one selected item at a time; clicking the selected item deselects it."
                                                           name="./selectionMode">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <multiple jcr:primaryType="nt:unstructured" text="Multiple" value="multiple" selected="{Boolean}true"/>
                                                    <single jcr:primaryType="nt:unstructured" text="Single" value="single"/>
                                                </items>
                                            </selectionMode>
                                            <tickOptions jcr:primaryType="nt:unstructured"
                                                         sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                         fieldLabel="Options showing tick mark"
                                                         fieldDescription="Option values (as in the Items list) that show a tick mark in 'Card with tick mark' style. Leave empty to show ticks on all options.">
                                                <field jcr:primaryType="nt:unstructured"
                                                       sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                       name="./tickOptions"/>
                                            </tickOptions>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </basic>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
